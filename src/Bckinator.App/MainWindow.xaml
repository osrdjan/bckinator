<Window x:Class="Bckinator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="bckinator" Width="1180" Height="840" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="WindowClosing" Validation.Error="ValidationError">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="#30888888" BorderThickness="0,0,1,0" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="bckinator" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,3"/>
     <TextBlock Text="Desktop backups" Opacity="0.65" Margin="0,0,0,24"/>
     <TextBlock Text="PROFILES" Opacity="0.65" FontSize="12" Margin="0,0,0,10"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding IsIdle}" Margin="0,12,0,0">
     <Button Content="+ New profile" Command="{Binding NewProfile}" Padding="12,8" Margin="0,0,0,8"/>
     <UniformGrid Columns="2" Margin="0,0,0,8">
      <Button Content="Duplicate" Command="{Binding DuplicateProfile}" Margin="0,0,4,0" Padding="4,7"/>
      <Button Content="Delete" Command="{Binding DeleteProfile}" Margin="4,0,0,0" Padding="4,7"/>
     </UniformGrid>
     <UniformGrid Columns="2">
      <Button Content="Import…" Command="{Binding ImportProfile}" Margin="0,0,4,0" Padding="4,7"/>
      <Button Content="Export…" Command="{Binding ExportProfile}" Margin="4,0,0,0" Padding="4,7"/>
     </UniformGrid>
     <TextBlock Text="Profiles store settings. Backups run only when you start them." TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,16,0,0"/>
    </StackPanel>
    <ListBox x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" Opacity="0.65" FontSize="12" ToolTip="{Binding Source}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,20,24,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="{Binding Draft.Name}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DraftState}" Opacity="0.65" Margin="0,5,0,12"/></StackPanel>
   <Border Grid.Row="1" BorderBrush="#FFD66B" BorderThickness="0,0,0,2" Padding="0,8,0,10" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" TextWrapping="Wrap"/></Border>
   <TabControl x:Name="WorkspaceTabs" Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
    <TabItem Header="Profile">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="4,12,12,12" IsEnabled="{Binding IsIdle}">
       <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProfileName" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
       <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Draft.Description, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
       <TextBlock Text="Source folder" Style="{StaticResource FieldLabel}"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSource}" Margin="8,0,0,0" Padding="12,6"/><TextBox x:Name="SourcePath" Text="{Binding Draft.Source, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></DockPanel>
       <TextBlock Text="Backup destination" Style="{StaticResource FieldLabel}"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseDestination}" Margin="8,0,0,0" Padding="12,6"/><TextBox x:Name="DestinationPath" Text="{Binding Draft.Destination, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></DockPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Output type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding Draft.Format}" Padding="8"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" IsEnabled="{Binding IsArchive}"><TextBlock Text="Compression preset" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding CompressionPresets}" SelectedItem="{Binding CompressionPreset}" Padding="8"/></StackPanel>
       </Grid>
       <TextBlock Text="Output name pattern" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Draft.NamingPattern, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
       <TextBlock Text="{Binding NamingExample, StringFormat='Example: {0}'}" Opacity="0.65" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="Use .NET date/time placeholders, e.g. backup_{yyyyMMdd_HHmmss}. Archives contain a root folder with the generated name." Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <Expander Header="Advanced compression · LZMA2" IsEnabled="{Binding IsArchive}">
        <UniformGrid Columns="3" Margin="0,8,0,8">
         <StackPanel Margin="0,0,12,8"><TextBlock Text="Level (0–9)"/><TextBox Text="{Binding Draft.Compression.Level, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Padding="8"/></StackPanel>
         <StackPanel Margin="0,0,12,8"><TextBlock Text="Dictionary (MB)"/><TextBox Text="{Binding Draft.Compression.DictionaryMb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Padding="8"/></StackPanel>
         <StackPanel Margin="0,0,0,8"><TextBlock Text="Fast bytes (5–273)"/><TextBox Text="{Binding Draft.Compression.FastBytes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Padding="8"/></StackPanel>
         <StackPanel Margin="0,0,12,0"><TextBlock Text="Solid block (GB)"/><TextBox Text="{Binding Draft.Compression.SolidBlockGb, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Padding="8"/></StackPanel>
         <StackPanel Margin="0,0,12,0"><TextBlock Text="Threads"/><TextBox Text="{Binding Draft.Compression.Threads, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Padding="8"/></StackPanel>
        </UniformGrid>
       </Expander>
       <TextBlock Text="Large dictionaries and many threads can use substantial RAM. Staging needs space for a full copy plus the archive." TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,10,0,10"/>
       <CheckBox Content="Exclude symbolic links and junctions (recommended)" IsChecked="{Binding Draft.ExcludeLinks}" Margin="0,5"/>
       <TextBlock Text="When disabled, only targets inside the source are followed. Cycles and external targets are skipped and reported." Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,6"/>
       <CheckBox Content="Continue with warnings when a file cannot be read or copied" IsChecked="{Binding Draft.ContinueOnErrors}" Margin="0,5"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Rules">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="4,12,12,12" IsEnabled="{Binding IsIdle}">
       <TextBlock Text="Global rules" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="Exclusions always win, including inside scoped inclusions. Reordering changes display order only." TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,12"/>
       <CheckBox Content="Include only items matching enabled global Include rules" IsChecked="{Binding Draft.IncludeOnly}" Margin="0,0,0,10"/>
       <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Draft.Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" MinHeight="160" MaxHeight="280" HeadersVisibility="Column" EnableRowVirtualization="True">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="On" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="Action" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.RuleActions, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="Match type" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.RuleKinds, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
       <WrapPanel Margin="0,10,0,0"><Button Content="Add rule" Command="{Binding AddRule}" Style="{StaticResource ActionButton}"/><Button Content="Remove" Command="{Binding RemoveRule}" Style="{StaticResource ActionButton}"/><Button Content="Move up" Command="{Binding MoveRuleUp}" Style="{StaticResource ActionButton}"/><Button Content="Move down" Command="{Binding MoveRuleDown}" Style="{StaticResource ActionButton}"/></WrapPanel>
       <TextBlock Text="DirectoryName: at any depth · FilePattern: filename at any depth · RelativePath: path and descendants · PathGlob: full relative path. Use * within a segment and ** across directories." TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,8,0,20"/>
       <TextBlock Text="Directory-specific include-only rules" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="Each scope narrows selection within its directory. Nested scopes apply together." TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,10"/>
       <DataGrid ItemsSource="{Binding Draft.Scopes}" SelectedItem="{Binding SelectedScope}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="85" MaxHeight="160">
        <DataGrid.Columns><DataGridTemplateColumn Header="On" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Relative directory" Binding="{Binding RelativeDirectory, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
       </DataGrid>
       <WrapPanel Margin="0,10,0,0"><Button Content="Add scope" Command="{Binding AddScope}" Style="{StaticResource ActionButton}"/><Button Content="Remove scope" Command="{Binding RemoveScope}" Style="{StaticResource ActionButton}"/></WrapPanel>
       <TextBlock Text="Included paths in the selected scope · one per line" Style="{StaticResource FieldLabel}"/>
       <TextBox IsEnabled="{Binding HasSelectedScope}" Text="{Binding SelectedScope.IncludePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="95" Padding="8" FontFamily="Consolas"/>
       <TextBlock Text="Example: diagrams/ includes the directory and its contents; ConsoleHost_history.txt includes that file. Global exclusions still apply." TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,6,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Preview">
     <Grid Margin="4,16,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <DockPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox ItemsSource="{Binding PreviewFilters}" SelectedItem="{Binding PreviewFilter}" MinWidth="120" DockPanel.Dock="Left" Padding="8"/><TextBox Text="{Binding PreviewSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by relative path or reason" AutomationProperties.Name="Filter preview by path or reason" Margin="12,0,0,0" Padding="8"/></DockPanel>
      <DataGrid Grid.Row="2" ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True">
       <DataGrid.Columns><DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="2*"/><DataGridCheckBoxColumn Header="Include" Binding="{Binding Included}" Width="65"/><DataGridTextColumn Header="Bytes" Binding="{Binding Size, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="Decision / reason" Binding="{Binding Reason}" Width="2*"/></DataGrid.Columns>
      </DataGrid>
     </Grid>
    </TabItem>
    <TabItem Header="History">
     <Grid Margin="4,16,4,4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True">
       <DataGrid.Columns><DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss zzz'}" Width="180"/><DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="155"/><DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"/><DataGridTextColumn Header="Bytes" Binding="{Binding OutputBytes, StringFormat=N0}" Width="85"/></DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" Margin="0,12,0,12"><TextBlock Text="{Binding SelectedRun.OutputPath}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedRun.Message}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedRun.RetainedStagingPath, StringFormat='Retained staging: {0}'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"/></StackPanel>
      <WrapPanel Grid.Row="2"><Button Content="Open output location" Command="{Binding OpenOutput}" Style="{StaticResource ActionButton}"/><Button Content="Locate run log" Command="{Binding OpenLog}" Style="{StaticResource ActionButton}"/><Button Content="Open retained staging" Command="{Binding OpenStaging}" Style="{StaticResource ActionButton}"/></WrapPanel>
     </Grid>
    </TabItem>
    <TabItem Header="Settings">
     <StackPanel Margin="4,16,12,4" IsEnabled="{Binding IsIdle}">
      <TextBlock Text="7-Zip executable" Style="{StaticResource FieldLabel}"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSevenZip}" Margin="8,0,0,0" Padding="12,6"/><TextBox Text="{Binding Settings.SevenZipPath, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></DockPanel>
      <TextBlock Text="Use the installed 64-bit 7z.exe. Folder backups work without 7-Zip." TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,16"/>
      <Button Content="Save settings" Command="{Binding SaveSettings}" HorizontalAlignment="Left" Style="{StaticResource ActionButton}"/>
      <TextBlock Text="Application data" Style="{StaticResource FieldLabel}" Margin="0,32,0,8"/><TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Opacity="0.65"/>
      <Button Content="Open application data" Command="{Binding OpenAppData}" HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Margin="0,12,0,0"/>
     </StackPanel>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="3" Margin="0,12,0,0">
    <TextBlock Text="{Binding Operation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Operation}" Margin="0,0,0,6"/>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="5"/>
    <Expander Header="Execution log" IsExpanded="{Binding LogsExpanded}" Margin="0,8,0,0"><ListBox ItemsSource="{Binding Logs}" Height="110" FontFamily="Consolas" FontSize="12" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"/></Expander>
   </StackPanel>
   <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
    <Button x:Name="SaveButton" Content="Save profile" Command="{Binding SaveProfile}" Style="{StaticResource ActionButton}"/>
    <Button x:Name="PreviewButton" Content="Preview" Command="{Binding Preview}" Style="{StaticResource ActionButton}"/>
    <Button x:Name="RunButton" Content="Start backup" Command="{Binding StartBackup}" Background="#0067B8" Foreground="White" Style="{StaticResource ActionButton}"/>
    <Button Content="Cancel" Command="{Binding Cancel}" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Margin="0"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
