{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/osrdjan/bckinator/blob/main/docs/profile.schema.json",
  "title": "Bckinator exported profile v1",
  "type": "object",
  "required": ["schemaVersion", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/profile" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["name", "source", "destination", "namingPattern", "format"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "namingPattern": { "type": "string", "minLength": 1 },
        "format": { "enum": ["Folder", "SevenZip", "WinRar"] },
        "excludeLinks": { "type": "boolean", "default": true },
        "continueOnErrors": { "type": "boolean", "default": false },
        "includeOnly": { "type": "boolean", "default": false },
        "compression": { "$ref": "#/$defs/compression" },
        "rarCompression": { "$ref": "#/$defs/rarCompression" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } }
      }
    },
    "compression": {
      "type": "object",
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "dictionaryMb": { "type": "integer", "minimum": 1, "maximum": 1536 },
        "fastBytes": { "type": "integer", "minimum": 5, "maximum": 273 },
        "solidBlockGb": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "threads": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "rarCompression": {
      "type": "object",
      "properties": {
        "method": { "enum": ["Store", "Fastest", "Fast", "Normal", "Good", "Best"], "default": "Best" },
        "dictionaryMb": { "enum": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024], "default": 256 },
        "solid": { "type": "boolean", "default": true },
        "recoveryRecord": { "type": "boolean", "default": true },
        "recoveryRecordPercent": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 5 },
        "longRangeSearch": { "type": "boolean", "default": true },
        "useBlake2": { "type": "boolean", "default": true }
      }
    },
    "rule": {
      "type": "object",
      "required": ["kind", "pattern"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "action": { "enum": ["Exclude", "Include"], "default": "Exclude" },
        "kind": { "enum": ["DirectoryName", "FilePattern", "RelativePath", "PathGlob"] },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "required": ["relativeDirectory", "includePatterns"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "relativeDirectory": { "type": "string", "minLength": 1 },
        "includePatterns": { "type": "string", "minLength": 1, "description": "One relative path or glob per line; literal directories include descendants." }
      }
    }
  }
}
